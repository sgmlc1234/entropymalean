# Copy to `.env` and fill in only what the stage you are running needs.
#
# Sections 1 and 2 of REVIEWERS.md -- verifying the release, replaying it
# through an independent kernel -- read nothing from this file. You need it for
# generation (section 4) and for the hosted models in evaluation (section 3).
#
# Every variable below is read by code on a live path. Variables that only the
# retired campaign drivers under scripts/archive/ read are not listed; they
# would be noise for anyone reproducing this work.
#
# Anything with a default in code is marked as such and can be left unset.


# ─────────────────────────────────────────────────────────────────────────────
# 1. Generation  (scripts/generate/)
# ─────────────────────────────────────────────────────────────────────────────

# The generator writes one candidate per slot. The orchestrator decides which
# parents meet and what the child should attempt. They are deliberately
# different models: the planner is the smaller number of calls and the larger
# share of the outcome, and no model grades its own output.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GENERATION_PROVIDER=openrouter
ORCHESTRATOR_MODEL=
VERIFICATION_MODEL=

# Two names, read by different layers, and setting only one is a quiet
# no-op. `run_eml1_main.sh` reads GENERATOR_MODEL and passes it to the pool
# generator as a flag; the library reads GENERATION_MODEL when no flag arrives.
# Set both to the same value unless you know which path you are on.
GENERATOR_MODEL=
GENERATION_MODEL=

# The judge that decides whether a child demands reasoning its parent's proof
# does not supply. It runs on a model other than the generator's, so it moves
# when the generator does. Admission needs `strong` and `keep` from two
# independent passes; one verdict is worth about 80%.
PROBLEM_JUDGE=1
PROBLEM_JUDGE_MODEL=
PROBLEM_JUDGE_TIMEOUT=300          # default 300

# A separate knob, read only by scripts/faithfulness/reader/measure_judge_accuracy.py,
# which scores the judge against hand labels. It refuses to run when it would
# grade a model with itself.
# JUDGE_MODEL=

# Campaign shape. EML_ rather than MAX_GENERATIONS because run_eml1_main.sh
# sources this file under `set -a`, so a `${MAX_GENERATIONS:-3}` inside it would
# read whatever is here and silently ignore the flag. Any knob for that driver
# needs a name this file does not already use.
EML_GENERATIONS=10
EML_OUT=data/certified/my_campaign
EML_ORDER=reverse                  # or `forward`; which groups a cut-short run reaches

# Optional generator controls, all defaulted in code.
# GENERATION_TEMPERATURE=
# GENERATION_REASONING_EFFORT=
# GENERATION_REASONING_EXCLUDE=
# GENERATION_LLM_TIMEOUT=
# GENERATION_LLM_TRANSPORT_RETRIES=
# GENERATION_LLM_TRANSPORT_BACKOFF=
# POOL_GENERATION_MAX_RETRIES=
# POOL_PROOF_REPAIR_TURNS=
# POOL_STATEMENT_FIRST=
# OP_TYPE_LOCK=                    # force one operator, for ablations


# ─────────────────────────────────────────────────────────────────────────────
# 2. Lean verification
# ─────────────────────────────────────────────────────────────────────────────

# Every generated row is compiled before it is considered. `repl` keeps a
# Mathlib environment resident, which is why it is worth a pool.
LEAN_VERIFIER=repl
LEAN_PROJECT_DIR=.
# LAKE_PATH=                       # default: `lake` on PATH

# One REPL holds a whole Mathlib environment in memory. Thirty of them swapped a
# 48 GB machine; two to four per run is the useful range.
LEAN_REPL_POOL_SIZE=2
# LEAN_TIMEOUT / LEAN_MAX_HEARTBEATS / LEAN_REPL_MAX_HEARTBEATS
# LEAN_MEMORY_MB / LEAN_THREADS / LEAN_CONCURRENCY_PER_EXPANSION
# GEN0_LEAN_TIMEOUT                all defaulted in code


# ─────────────────────────────────────────────────────────────────────────────
# 3. The faithfulness layer  (scripts/faithfulness/)
# ─────────────────────────────────────────────────────────────────────────────

# Checks that decide against the judge rather than after it, because each
# carries a Lean proof where the judge carries an opinion.

# Vacuity: can Lean derive False from the hypotheses alone?
# VACUITY_PROBE_TIMEOUT=

# Dead hypotheses: remove each and recompile.
# HYPOTHESIS_PRUNE=
# HYPOTHESIS_PRUNE_TIMEOUT=

# Redundancy: does one parent already prove the child outright? With the prover
# on, this asks a model to find such a proof, so it needs a model.
# REDUNDANCY_USE_PROVER=
# REDUNDANCY_PROVER_MODEL=
# REDUNDANCY_PROVER_TRIES=
# REDUNDANCY_TIMEOUT=

# Identity: alpha-normal collision against earlier campaigns, not just this run.
# DEDUP_GATE=
# DEDUP_CORPUS_ROOTS=              # extra corpora to compare against
# DISABLE_NOVELTY_MEMORY=
# NOVELTY_ACCEPTED_LEDGER_PATH=

# Kernel replay (Linux only -- the sandbox is Landlock through `landrun`).
# COMPARATOR_MATHLIB=              # this machine's mathlib package directory
# COMPARATOR_WORKSPACES=data/release/comparator
# COMPARATOR_OUT=data/release/comparator_results.json
# COMPARATOR_TIMEOUT=900
# TOOLCHAIN= / MATHLIB_REV= / GO_VER= / LANDRUN_VER=    used by comparator_setup.sh


# ─────────────────────────────────────────────────────────────────────────────
# 4. Evaluation  (scripts/evaluate/)
# ─────────────────────────────────────────────────────────────────────────────

# The two local provers are served by llama.cpp and need no key; see
# scripts/provers.sh at the repository root. BFS must be llama.cpp: it ranks its
# frontier by cumulative token log-probability, and LM Studio returns
# `logprobs: null` on the completions endpoint, so the search silently
# degenerates into an unranked one.
# LM_STUDIO_BASE_URL=

# Hosted panel models. Reuses OPENROUTER_API_KEY from section 1.
# OPENROUTER_PROVIDER_ORDER=
# OPENROUTER_ALLOW_FALLBACKS=
# OPENROUTER_REQUIRE_PARAMETERS=

# The spend watchdog stops billed cells before the credit limit is reached.
# OPENROUTER_API=                  # key used for the billing endpoint
# SPEND_RESERVE=
# SPEND_POLL=

# Prover sampling. Fixed seeds are accepted but the panel runs at temperature
# 1.0, so Pass@3 is not reproducible episode for episode. Verification is:
# scripts/evaluate/verify_solved_episodes.py re-elaborates every stored proof.
# BFS_TEMPERATURE= / BFS_TOP_P= / BFS_MAX_TOKENS= / BFS_SEED=
# GOEDEL_TEMPERATURE= / GOEDEL_TOP_P= / GOEDEL_MAX_TOKENS= / GOEDEL_SEED=
# GOEDEL_PROMPT_STYLE=


# ─────────────────────────────────────────────────────────────────────────────
# 5. Optional
# ─────────────────────────────────────────────────────────────────────────────

# Tracing. Off by default; nothing requires it.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# LeanSearch lookups during generation. Disabled cleanly if unreachable.
# LEANSEARCH_DISABLED=1
# LEANSEARCH_ENDPOINT=
# LEANSEARCH_CACHE_DIR=
# LEANSEARCH_MAX_QUERIES_PER_PROBLEM=

# Fallback when OPENROUTER_API_KEY is unset.
# OPENAI_API_KEY=
# OPENAI_MODEL=
